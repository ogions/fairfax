{
  "name": "@goldenrod-app/fairfax",
  "version": "0.2.0",
  "description": "A Fountain editor component for the web.",
  "license": "MIT",
  "author": "Zach Lo",
  "type": "module",
  "exports": {
    ".": {
      "import": "./dist/fairfax.js",
      "types": "./dist/fairfax.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "main": "dist/fairfax.js",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ogions/fairfax.git"
  },
  "scripts": {
    "clean": "rm -rf dist",
    "build:types": "tsc --emitDeclarationOnly --outDir dist",
    "build:esbuild": "esbuild src/fairfax.ts --bundle --format=esm --outfile=dist/fairfax.js",
    "build": "npm run clean && npm run build:types && npm run build:esbuild",
    "test": "npm run build && cp dist/fairfax.js demo/fairfax.js && http-server demo",
    "prepare": "npm run build"
  },
  "dependencies": {
    "@goldenrod-app/hyperion": "^0.1.0"
  },
  "devDependencies": {
    "esbuild": "^0.25.2",
    "http-server": "^14.1.1",
    "typescript": "^5.9.3"
  }
}
