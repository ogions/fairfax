{
  "name": "monica",
  "version": "0.1.0",
  "description": "A Fountain editor component for the web.",
  "license": "MIT",
  "author": "Zach Lo",
  "type": "module",
  "files": ["dist"],
  "main": "dist/monica.js",
  "repository": {
    "type": "git",
    "url": "https://github.com/ogions/monica"
  },
  "scripts": {
    "clean": "rm -rf dist",
    "build:types": "tsc --emitDeclarationOnly --outDir dist",
    "build:esbuild": "esbuild src/monica.ts --bundle --format=esm --outfile=dist/monica.js",
    "build": "npm run clean && npm run build:types && npm run build:esbuild",
    "test": "npm run build && cp dist/monica.js demo/monica.js && http-server demo",
    "prepare": "npm run build"
  },
  "dependencies": {
    "fairfax": "^0.1.0"
  },
  "devDependencies": {
    "esbuild": "^0.25.2",
    "http-server": "^14.1.1",
    "typescript": "^5.9.3"
  }
}
